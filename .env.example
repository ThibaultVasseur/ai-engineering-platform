# -----------------------------------------------------------------------------
# AI Engineering Multi-Agent Platform — modèle de configuration
# Copier vers `.env` et adapter. `.env` est ignoré par Git : ne jamais commiter de vrais secrets.
# Toutes les variables sont optionnelles ; les valeurs par défaut fonctionnent entièrement
# hors ligne (aucune clé d'API nécessaire).
# -----------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
APP_NAME=ai-engineering-platform
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # json (conteneurs) | console (développement local)

# --- Base de données (PostgreSQL + pgvector) ----------------------------------
# Correspond au service `postgres` de docker-compose.yml (rôle `app` non superutilisateur).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/ai_platform
DB_POOL_SIZE=5
DB_ECHO=false                       # journalise chaque requête SQL (débogage uniquement)
# Utilisée uniquement par les tests d'intégration.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/ai_platform_test

# --- Authentification et tenants ----------------------------------------------
# Avec AUTH_ENABLED=false, toute requête est servie comme DEFAULT_TENANT_ID (dev local uniquement).
AUTH_ENABLED=false
DEFAULT_TENANT_ID=default
# Liste JSON des empreintes SHA-256 des clés d'API. Pour en générer une :
#   uv run python -m scripts.generate_api_key --tenant acme
API_KEYS=[]

# --- Limitation de débit (par tenant, seau à jetons en mémoire) et taille des requêtes
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=1048576

# --- Fournisseur LLM -------------------------------------------------------------
# offline   : simulateur déterministe à base de règles (tests, CI, démo sans clé)
# anthropic : Claude via le SDK officiel (modèle par défaut claude-opus-5-5)
# openai    : tout endpoint Chat Completions compatible OpenAI (définir LLM_MODEL)
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=                        # anthropic : à défaut, la variable ANTHROPIC_API_KEY
LLM_BASE_URL=                       # serveurs compatibles OpenAI (vLLM, Ollama, LM Studio...)
LLM_EFFORT=medium                   # effort anthropic : low | medium | high | xhigh | max
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_REFUSAL_FALLBACK=true           # anthropic : repli côté serveur en cas de refus de sécurité
LLM_STRUCTURED_MAX_ATTEMPTS=3       # tentatives pour obtenir une sortie structurée valide (réparations comprises)
# Dollars US par million de tokens, pour appliquer MAX_RUN_COST_USD. Obligatoires (les deux)
# pour un modèle sans tarif intégré — tous sauf les modèles Claude ; 0 pour un modèle local gratuit.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- Embeddings ------------------------------------------------------------------
# hashing : embeddings locaux et déterministes par hachage de caractéristiques (sans réseau)
# openai  : endpoint /embeddings compatible OpenAI (dimension fixée à 512 par le schéma)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Observabilité (optionnelle) -------------------------------------------------
# Laisser vide pour tracer uniquement en local (table run_events + logs structurés).
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Garde-fous d'orchestration ----------------------------------------------------
MAX_AGENT_STEPS=40                  # étapes du graphe par run
MAX_AGENT_CALLS=16                  # appels d'agents par run
MAX_AGENT_RETRIES=2                 # cycles de reprise du critique
MAX_STEP_ATTEMPTS=2                 # tentatives par étape du plan en cas d'erreur d'un agent
MAX_TOOL_CALLS_PER_AGENT=6
MAX_PLAN_STEPS=6
MAX_RUN_SECONDS=300
MAX_RUN_COST_USD=2.0
MAX_CONCURRENT_RUNS=4
CRITIC_PASS_THRESHOLD=70
SUPERVISOR_STRATEGY=rules           # rules | llm (décision LLM validée par la politique)
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_OUTPUT_CHARS=8000          # les résultats d'outils sont tronqués au-delà de cette taille

# --- RAG ---------------------------------------------------------------------------
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_CANDIDATE_POOL=20
RAG_BLOCK_SUSPICIOUS_CHUNKS=true
